{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-gates.sh",
            "timeout": 600,
            "statusMessage": "Running cargo gates before commit…"
          }
        ]
      }
    ]
  }
}
